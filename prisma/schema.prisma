// Prisma Schema — forjaviral-site
// SQLite por default; PostgreSQL em produção via DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Plan {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  price        Int
  currency     String   @default("BRL")
  interval     String
  abacatePlanId String?
  features     Json
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders         Order[]
  subscriptions Subscription[]

  @@index([slug])
  @@index([active])
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  phone     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  orders         Order[]
  subscriptions  Subscription[]
  credentials    AccessCredentials[]

  @@index([email])
}

model Order {
  id                String   @id @default(cuid())
  customerId        String
  planId            String
  status            String
  abacateCheckoutId String?
  abacateOrderId    String?
  amount            Int
  currency          String   @default("BRL")
  metadata          Json?
  createdAt         DateTime @default(now())
  paidAt            DateTime?

  // Rastreamento de Afiliados / Criadores de Conteúdo
  affiliateId       String?
  affiliate         Affiliate?       @relation(fields: [affiliateId], references: [id])
  couponCode        String?
  commissionAmount  Int?             @default(0) // centavos de comissão
  commissionStatus  String?          @default("pending") // pending | credited | paid | refunded
  payoutId          String?
  payout            AffiliatePayout? @relation(fields: [payoutId], references: [id])

  customer Customer @relation(fields: [customerId], references: [id])
  plan     Plan     @relation(fields: [planId], references: [id])
  credentials AccessCredentials[]

  @@index([customerId])
  @@index([status])
  @@index([abacateCheckoutId])
  @@index([createdAt])
  @@index([affiliateId])
  @@index([commissionStatus])
  @@index([payoutId])
}

model Subscription {
  id                     String   @id @default(cuid())
  customerId             String
  planId                 String
  status                 String
  provider               String   @default("AbacatePay")
  providerSubscriptionId String?
  currentPeriodEnd       DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  orderId                String?

  customer Customer @relation(fields: [customerId], references: [id])
  plan     Plan     @relation(fields: [planId], references: [id])
  credentials AccessCredentials[]

  @@index([customerId])
  @@index([status])
  @@index([providerSubscriptionId])
}

model AccessCredentials {
  id             String    @id @default(cuid())
  customerId     String
  orderId        String?
  subscriptionId String?
  username       String
  passwordHash   String?
  plainPassword  String?
  accessTokenHash String?
  accessUrl      String
  railwayAppUrl  String?
  licenseKey     String?
  credits        Int?      @default(100)
  courseUrl      String?
  status         String    @default("pending")
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  order     Order?     @relation(fields: [orderId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([accessTokenHash])
}

model WebhookEvent {
  id         String   @id @default(cuid())
  provider   String   @default("AbacatePay")
  eventId    String   @unique
  type       String
  payload    Json
  signature  String?
  processed  Boolean  @default(false)
  createdAt  DateTime @default(now())
  orderId    String?

  @@index([provider])
  @@index([eventId])
  @@index([processed])
  @@index([createdAt])
  @@index([orderId])
}

model AuditLog {
  id        String   @id @default(cuid())
  eventType String
  userId    String?
  orderId   String?
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([orderId])
  @@index([createdAt])
}

model Affiliate {
  id                String            @id @default(cuid())
  name              String
  email             String            @unique
  slug              String            @unique
  couponCode        String            @unique
  discountPercent   Int               @default(0) // % desconto pro cliente (ex: 5% ou 10%)
  commissionPercent Int               @default(20) // % comissão do YouTuber (ex: 20%)
  pixKey            String
  pixKeyType        String            @default("cpf") // cpf | cnpj | email | phone | random
  token             String            @unique @default(cuid()) // Token secreto para o painel privado do parceiro
  active            Boolean           @default(true)
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  orders            Order[]
  payouts           AffiliatePayout[]

  @@index([slug])
  @@index([couponCode])
  @@index([token])
  @@index([active])
}

model AffiliatePayout {
  id               String    @id @default(cuid())
  affiliateId      String
  period           String    // Ex: "2026-10"
  totalSales       Int       @default(0)
  totalAmount      Int       @default(0) // centavos
  commissionAmount Int       @default(0) // centavos
  status           String    @default("pending") // pending | paid | canceled
  paidAt           DateTime?
  proof            String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  affiliate        Affiliate @relation(fields: [affiliateId], references: [id])
  orders           Order[]

  @@index([affiliateId])
  @@index([period])
  @@index([status])
}