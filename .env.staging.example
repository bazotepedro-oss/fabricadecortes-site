# Copy to .env.staging.local (ignored by Git) and fill with isolated staging values only.
DATABASE_URL=postgresql://<staging-user>:<password>@<staging-host>/<staging-db>
ACCESS_TOKEN_SECRET=<random-32-plus-characters>
ADMIN_PASSWORD=<unique-16-plus-character-password>
ADMIN_EMAIL=staging-admin@example.test
FORJA_LICENSE_SERVER_URL=https://<staging-license-host>
FORJA_LICENSE_ADMIN_TOKEN=<same-as-staging-license-ADMIN_TOKEN>
MEMBERS_API_URL=https://<staging-members-host>/api.php
MEMBERS_ADMIN_SECRET=<same-as-staging-members-secret>
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
RESEND_API_KEY=
