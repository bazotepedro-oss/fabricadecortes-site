# ──────────────────────────────────────────────────────────────
# FÁBRICA DOS CORTES — Variáveis de Ambiente para Vercel / Produção
# Copie os valores e cole nas Environment Variables do projeto na Vercel
# ──────────────────────────────────────────────────────────────

# 🌐 Domínio Oficial do Site
NEXT_PUBLIC_APP_URL=https://fabricadecortes.com
NODE_ENV=production

# 🗄️ Banco de Dados (Prisma)
# SQLite por padrão (file:./dev.db) ou Postgres URL
DATABASE_URL=file:./dev.db

# 🥑 AbacatePay (API v2)
# Pegue a chave de produção no painel da AbacatePay (começa com abc_prod_)
ABACATEPAY_API_KEY=abc_prod_SUA_CHAVE_AQUI
ABACATEPAY_WEBHOOK_SECRET=seu_webhook_secret_gerado_no_painel
ABACATEPAY_RETURN_URL=https://fabricadecortes.com/retorno
ABACATEPAY_APP_NAME=Fábrica de Cortes
ABACATEPAY_PLAN_IDS={"pack_teste":"pack_teste","pack_criador":"pack_criador","pack_escala":"pack_escala"}

# 🔑 Servidor de Licenças / PostgreSQL (Railway)
FORJA_LICENSE_SERVER_URL=https://forja-license-production.up.railway.app
FORJA_LICENSE_ADMIN_TOKEN=FV291125

# 🐊 Área de Membros (HostGator)
NEXT_PUBLIC_MEMBERS_URL=https://membros.fabricadecortes.com/index.php
MEMBERS_URL=https://membros.fabricadecortes.com/index.php
MEMBERS_API_URL=https://membros.fabricadecortes.com/api.php

# 📦 Entrega do Conteúdo & Comunidade
GOOGLE_DRIVE_URL=https://drive.google.com/drive/u/4/folders/16U_qUEtjAlgmgmeX_HWuqPw-3dYgoekf
WHATSAPP_GROUP_URL=https://chat.whatsapp.com/JlJ6ZJjBNpS7E9ErFSyMvC
COLAB_NOTEBOOK_URL=https://colab.research.google.com/github/bazotepedro-oss/forjaviral/blob/main/ViralCutter.ipynb

# 🛡️ Painel Admin do Site
ADMIN_EMAIL=admin@fabricadecortes.com
ADMIN_PASSWORD=SuaSenhaForteSp@2026
ACCESS_TOKEN_SECRET=fabrica-de-cortes-secure-access-token-secret-2026
ACCESS_LINK_EXPIRATION_HOURS=72

# ✉️ E-mail Transacional (Resend)
RESEND_API_KEY=re_SEU_TOKEN_RESEND
EMAIL_FROM=Fábrica de Cortes <contato@fabricadecortes.com>

# ⏱️ Rate Limiting
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000