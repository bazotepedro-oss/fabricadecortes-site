NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL persistente (SQLite local não é suportado pela aplicação em runtime)
DATABASE_URL=postgresql://user:password@localhost:5432/fabricadecortes
DB_POOL_MAX=4

# Gere valores aleatórios únicos com pelo menos 32 caracteres.
ACCESS_TOKEN_SECRET=CHANGE_ME_WITH_RANDOM_SECRET_MIN_32_CHARS
ADMIN_PASSWORD=CHANGE_ME_WITH_UNIQUE_STRONG_PASSWORD
ADMIN_EMAIL=admin@fabricadecortes.com
FORJA_LICENSE_ADMIN_TOKEN=CHANGE_ME_WITH_RANDOM_SECRET_MIN_32_CHARS
MEMBERS_ADMIN_SECRET=CHANGE_ME_WITH_RANDOM_SECRET_MIN_32_CHARS

ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=CHANGE_ME_WITH_RANDOM_SECRET_MIN_32_CHARS
ABACATEPAY_BASE_URL=https://api.abacatepay.com
ABACATEPAY_RETURN_URL=http://localhost:3000/retorno
ABACATEPAY_PLAN_IDS={}

FORJA_LICENSE_SERVER_URL=https://forja-license-production.up.railway.app
MEMBERS_API_URL=https://membros.fabricadecortes.com/api.php
MEMBERS_URL=https://membros.fabricadecortes.com/index.php
RESEND_API_KEY=
EMAIL_FROM=
